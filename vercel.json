{
  "version": 2,
  "builds": [
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    },
    {
      "src": "server/package.json",
      "use": "@vercel/node",
      "config": {
        "buildCommand": "pnpm nx run server:build --configuration=production"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server/dist/main.js" },
    { "src": "/(.*)", "dest": "/client/$1" }
  ]
}
